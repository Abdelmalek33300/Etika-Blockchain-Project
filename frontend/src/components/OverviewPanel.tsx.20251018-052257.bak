  // Conteneur centré avec marges identiques
  page: { width: "100%", maxWidth: 1180, margin: "0 auto", padding: "30px 40px 80px 40px", boxSizing: "border-box" },

  section: { padding: "28px 0 24px", borderBottom: "1px solid #eef2f7" },

  // Grille (2 colonnes)
  row: { display: "grid", gridTemplateColumns: "1fr 1fr", gap: 24, alignItems: "start", justifyItems: "stretch" },

  // Colonnes
  colImgLeft:  { width: "100%", textAlign: "center", display: "flex", alignItems: "flex-start", justifyContent: "center" },
  colTextRight:{ width: "100%" },
  colTextLeft: { width: "100%" },
  colImgRight: { width: "100%", textAlign: "center", display: "flex", alignItems: "flex-start", justifyContent: "center" },

  // Visuels fondus légers (pas de cercle, pas d’encart coloré)
  imgBlendBoxLeft: {
    width: "100%", height: 300, minHeight: 220, borderRadius: 14, overflow: "hidden",
    backgroundSize: "cover", backgroundPosition: "center left", backgroundRepeat: "no-repeat",
    boxShadow: "none", border: "none", backgroundColor: "#fff",
  },
  imgBlendBoxRight: {
    width: "100%", height: 300, minHeight: 220, borderRadius: 14, overflow: "hidden",
    backgroundSize: "cover", backgroundPosition: "center right", backgroundRepeat: "no-repeat",
    boxShadow: "none", border: "none", backgroundColor: "#fff",
  },
  // Variante "contain" pour préserver 100% de l'image (maillet)
  imgBlendBoxRightContain: {
    width: "100%", height: 320, minHeight: 220, borderRadius: 14, overflow: "hidden",
    backgroundSize: "cover, contain", backgroundPosition: "center right, center right", backgroundRepeat: "no-repeat, no-repeat",
    boxShadow: "none", border: "none", backgroundColor: "#fff",
  },

  // Typo
  h1: { fontSize: 30, margin: "0 0 10px", lineHeight: 1.25, color: "#0078D4" },
  h2: { fontSize: 24, margin: "0 0 8px", lineHeight: 1.25, color: "#0078D4" },
  p:  { textAlign: "justify", color: "#111827", margin: "0 0 12px", lineHeight: 1.7 },

  textBox: { maxWidth: 640 },
  ul: { marginTop: 0, marginBottom: 12, paddingLeft: 22, color: "#111827", lineHeight: 1.7 },

  // Liens
  moreRow: { display: "flex", gap: 8, marginTop: 8, flexWrap: "wrap" },
  moreBtn: {
    display: "inline-block", padding: "8px 12px", borderRadius: 999,
    border: "1px solid #111827", background: "#111827", color: "#ffffff",
    textDecoration: "none", fontWeight: 600, fontSize: 12.5, lineHeight: 1.2,
    transition: "all 120ms ease", cursor: "pointer",
  },
  moreBtnHover: { background: "#0e0e0e", border: "1px solid #0b0b0b", boxShadow: "0 4px 12px rgba(0,0,0,0.25)" },

  // CTA
  ctaRowNoWrap: { display: "flex", flexWrap: "nowrap", gap: 10, marginTop: 10, overflowX: "auto" },
  cta: {
    display: "inline-block", whiteSpace: "nowrap", padding: "10px 16px", borderRadius: 999,
    border: "1px solid #e5e7eb", textDecoration: "none", color: "#111827", background: "#ffffff", fontWeight: 500,
  },
};








