import React from "react";

// Images (intro = monetiser-caddie.png selon tes derniers choix)
import imgIntro from "../assets/images/monetiser-caddie.png";
import imgFonctionnement from "../assets/images/encheres.png";
import imgMecanique from "../assets/images/mecanique-engrenages.png";
import imgStrategie from "../assets/images/strategie-ampoule.png";
import imgAvenir from "../assets/images/avenir-globe.png";

const DOCS_BASE = (import.meta as any)?.env?.VITE_LEARN_BASE || "http://localhost:4100";
const REGISTER_BASE = (import.meta as any)?.env?.VITE_REGISTER_BASE || window.location.origin;

// Bouton “En savoir plus”
const MoreLink: React.FC<{ href: string; children: React.ReactNode }> = ({ href, children }) => {
  const [hover, setHover] = React.useState(false);
  return (
    <a
      href={href}
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
      style={{ ...styles.moreBtn, ...(hover ? styles.moreBtnHover : {}) }}
    >
      {children}
    </a>
  );
};

export default function OverviewPanel() {
  return (
    <>
      {/* Reset minimal pour éviter marges/paddings globaux parasites */}
      <style>{`body, #root { margin: 0; padding: 0; }`}</style>

      {/* Conteneur centré */}
      <div style={styles.wrapper}>
        <main style={styles.page}>

          {/* ============= Intro (image GAUCHE / texte DROITE) =============
              ⚠️ Pas de doublon HERO ici : on laisse le titre “LE PROJET / ÉTIKA” et les 5 phrases UNIQUEMENT dans HeroTop.tsx
              On restaure le texte explicatif long comme discuté. */}
          <section style={styles.section}>
            <div style={styles.row}>
              <div style={styles.colImgLeft}>
                {/* Image fondue légèrement dans le blanc, sans bordure */}
                <div
